# ApiCoreX Identity Plugin — example environment.
# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# ── Required ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. The plugin owns this database.
DATABASE_URL=postgres://user:password@localhost:5432/apicorex?sslmode=disable

# HS256 secret used to SIGN access tokens. Must match Core's JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-secret

# Key presented to Core when this plugin registers. Must match Core's PLUGIN_API_KEY.
PLUGIN_API_KEY=change-me-plugin-key

# Core's HTTP base URL (where this plugin registers and pulls manifests from).
CORE_URL=http://localhost:8080

# ── Plugin server ──────────────────────────────────────────────────────────
# Local bind address.
PLUGIN_ADDR=:50051
# URL Core uses to reach this plugin. Important in docker/k8s where the bind
# address differs from the reachable URL. If empty, derived from the bind addr.
PLUGIN_BASE_URL=http://localhost:50051

# ── Optional: logout / token revocation ────────────────────────────────────
# Enables immediate access-token revocation on logout. Shared with Core.
# REDIS_URL=redis://localhost:6379/0

# ── Optional: platform admins ──────────────────────────────────────────────
# Bootstraps is_platform_admin (a DB column — the real source of truth, so
# every identity instance agrees) for already-registered users on boot. Only
# grants, never revokes; emails that haven't registered yet are skipped. After
# boot, manage admins via POST/DELETE /platform-admins instead of redeploying.
# PLATFORM_ADMIN_EMAILS=ops@yourcompany.com,you@yourcompany.com

# ── Optional: Google login (password-free sign-in) ─────────────────────────
# Comma-separated OAuth 2.0 client IDs whose ID tokens are accepted at
# POST /auth/google — one per platform that signs users in (Android, Web,
# Desktop). A token's "aud" claim must match one of these. Leave unset to
# disable Google login entirely. Staff are matched by verified email and must
# already exist — Google login never creates accounts.
# GOOGLE_CLIENT_IDS=1234-web.apps.googleusercontent.com,5678-android.apps.googleusercontent.com

# ── Testing only (integration tests with a remote container engine) ─────────
# See TESTING.md. Set when the Podman/Docker engine runs on another host so the
# container's mapped port resolves to the engine, not localhost.
# TEST_DB_HOST=100.119.254.20
